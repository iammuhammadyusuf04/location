# @BotFather dan olingan token
BOT_TOKEN=123456:ABC...
# Faqat shu Telegram ID lar uchun ishlaydi (vergul bilan bir nechta: 111,222). @userinfobot orqali bilib oling. Bo'sh qoldirsa - hamma uchun ochiq.
ALLOWED_USER_ID=
# Vaqt mintaqasi va kunlik hisobot vaqti
TZ=Asia/Tashkent
SUMMARY_TIME=23:55
# Necha daqiqada bir marta joylashuv saqlanadi/xabar beriladi
INTERVAL_MIN=10

# PWA (veb-ilova). WEB_KEY - o'zingiz o'ylab topgan uzun maxfiy so'z.
WEB_KEY=
# Ilova ochiladigan HTTPS manzil (PWA o'rnatilishi uchun HTTPS shart), masalan https://loc.example.com
PUBLIC_URL=
PORT=8080

# Egasi (ota-ona): barcha xabarlar, ogohlantirishlar va hisobotlar shu ID ga keladi. Bo'sh bo'lsa - ALLOWED_USER_ID dagi birinchi ID.
OWNER_ID=
# Shuncha daqiqa signal bo'lmasa egasiga «signal uzildi» xabari yuboriladi
ALERT_AFTER_MIN=60

# Ixtiyoriy: PWA ni alohida hostingdan berish uchun. Odatda BO'SH qoldiring (PWA ni bot o'zi beradi).
PWA_URL=
